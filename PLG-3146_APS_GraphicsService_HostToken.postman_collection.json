              ],
              "query": [
                {
                  "key": "nsfilter",
                  "value": "{{nsfilter}}"
                },
                {
                  "key": "bucketKey",
                  "value": "{{bucketKey}}"
                }
              ]
            }
          }
        },
        {
          "name": "No host token (expect error)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Fails without host token', () => pm.expect(pm.response.code).to.be.within(400, 499));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{twinitToken}}"
              }
            ],
            "url": {
              "raw": "{{graphicsBase}}/aps/models?nsfilter={{nsfilter}}&bucketKey={{bucketKey}}",
              "host": [
                "{{graphicsBase}}"
              ],
              "path": [
                "aps",
                "models"
              ],
              "query": [
                {
                  "key": "nsfilter",
                  "value": "{{nsfilter}}"
                },
                {
                  "key": "bucketKey",
                  "value": "{{bucketKey}}"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}