{
  "name": "platform-reference-app-automation",
  "version": "1.0.0",
  "description": "Playwright automation framework for Invicara Reference App",
  "scripts": {
    "ref:regression": "node scripts/run-tests.js reference-app",
    "ref:regression:newuser": "node scripts/run-tests.js new-user",
    "viewer:regression": "node scripts/run-tests.js iaf-viewer",
    "viewer:regression:update": "node scripts/run-tests.js iaf-viewer-update",
    "xray:upload:ref": "ts-node scripts/xray-upload.ts --app=reference-app",
    "xray:upload:viewer": "ts-node scripts/xray-upload.ts --app=iaf-viewer",
    "report:open": "node scripts/report.js open",
    "report:clean": "node scripts/report.js clean"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "allure": "3.14.3",
    "allure-playwright": "^3.7.0",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "dotenv": "^16.4.5",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0"
  }
}
