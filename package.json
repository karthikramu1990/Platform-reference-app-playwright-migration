{
  "name": "platform-reference-app-automation",
  "version": "1.0.0",
  "description": "Playwright automation framework for Invicara Reference App",
  "scripts": {
    "test": "node scripts/run-tests.js reference-app",
    "test:ref": "node scripts/run-tests.js reference-app",
    "test:viewer": "node scripts/run-tests.js iaf-viewer",
    "test:all": "node scripts/run-tests.js all",
    "test:headed": "node scripts/run-tests.js reference-app --headed",
    "test:debug": "playwright test --debug",
    "test:qa1": "cross-env TEST_ENV=qa1 node scripts/run-tests.js reference-app",
    "test:qa2": "cross-env TEST_ENV=qa2 node scripts/run-tests.js reference-app",
    "test:eu-staging": "cross-env TEST_ENV=staging node scripts/run-tests.js reference-app",
    "test:oci-staging": "cross-env TEST_ENV=staging3 node scripts/run-tests.js reference-app",
    "test:oci-qa3": "cross-env TEST_ENV=qa3 node scripts/run-tests.js reference-app",
    "xray:upload": "ts-node scripts/xray-upload.ts",
    "xray:upload:ref": "ts-node scripts/xray-upload.ts --app=reference-app",
    "xray:upload:viewer": "ts-node scripts/xray-upload.ts --app=iaf-viewer",
    "report:open": "node scripts/report.js open",
    "report:clean": "node scripts/report.js clean"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "allure": "3.14.3",
    "allure-playwright": "^3.7.0",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "dotenv": "^16.4.5",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0"
  }
}
